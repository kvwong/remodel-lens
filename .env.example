OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: needed for OpenRouter image edits; can also be saved on the Settings page.
OPENROUTER_API_KEY=

# Optional model overrides
# ANALYSIS_MODELS=openai/gpt-6.1-sol,anthropic/claude-sonnet-5-5
# REASONING_MODEL=openai/gpt-6.1-sol
# REASONING_MODEL=openrouter/qwen/qwen3.8-27b
# ANALYSIS_MODELS=openrouter/qwen/qwen3.8-27b,openrouter/mistralai/mistral-small-3.2-24b-instruct
# IMAGE_MODEL=gpt-image-2.5-sunburst   (gpt-image-2.5-flare: same price, faster, less precise)
# IMAGE_MODEL=openrouter/black-forest-labs/flux.2-klein-4b
# IMAGE_CONCURRENCY=6   (image edits in flight across all running listings)
# EDGE_THRESHOLD=0.45   (edge check pass mark; `npm run tune` suggests a value from your runs)
# ALLOWED_HOSTS=your-machine.your-tailnet.ts.net   (exact hostnames, comma-separated; no scheme or port)
# For a localhost-only listener, launch with: HOST=127.0.0.1 npm run app
